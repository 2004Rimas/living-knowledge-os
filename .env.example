# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Living Knowledge OS
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/living_knowledge_os
REDIS_URL=redis://localhost:6379/0

# Clerk
CLERK_SECRET_KEY=your_clerk_secret_key

# LLM
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Vector Database
QDANT_URL=http://localhost:6333
QDANT_API_KEY=qdrant_key

# AWS
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=living-knowledge-os-bucket
AWS_REGION=us-east-1

# Development
NODE_ENV=development
DEBUG=true
